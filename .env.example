# ------------------------------------------------------------------
# Copie para .env.local e preencha. Nunca versione o arquivo real.
# Guia completo: docs/wiki/13-ambiente-e-setup.md
# ------------------------------------------------------------------

# URL da API .NET, usada pelo SERVIDOR Next.js (src/http, Server Actions).
# Privada — nunca chega ao browser.
# Local: http://localhost:5068 (ver soromaps_api/Properties/launchSettings.json)
API_URL=

# URL da API usada pelos Client Components do mapa (/home, /places/new).
#
# ATENÇÃO: tudo com prefixo NEXT_PUBLIC_ é gravado em texto puro no bundle
# que o visitante baixa. Em PRODUÇÃO esta variável é deliberadamente deixada
# de fora, porque a URL da API é tratada como segredo — e a consequência
# disso é o defeito descrito em docs/wiki/14-deploy.md.
# Em desenvolvimento, aponte para o mesmo valor de API_URL.
NEXT_PUBLIC_API_URL=

# Segredo HMAC que assina o cookie de sessão (JWT HS256).
# Sem ele, qualquer rota que toque sessão lança erro na hora.
# Cada dev gera o seu, com 32 caracteres: https://generate-secret.vercel.app/32
SESSION_SECRET=
